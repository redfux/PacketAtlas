#!/bin/bash
# Keeps the cache-busting `?v=` strings in sync with APP_VERSION (see
# bump-version.sh for why they exist), so a release can't be committed with
# stale ones. Release workflow: change only APP_VERSION in app.js and commit -
# the files this rewrites are staged automatically.
#
# One-time setup per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

version="$(sed -n "s/^const APP_VERSION = '\([^']*\)';.*/\1/p" app.js)"
if [[ -z "$version" ]]; then
  echo "pre-commit: APP_VERSION in app.js nicht gefunden" >&2
  exit 1
fi

files=(./*.js index.html)

./bump-version.sh "$version" > /dev/null

# Stage every file whose only uncommitted change is the version strings - whether
# this run rewrote them or an earlier manual ./bump-version.sh did. Files with any
# other unstaged edit are left alone, so unfinished work never sneaks into a commit.
for f in "${files[@]}"; do
  git diff --quiet -- "$f" && continue
  other_changes="$(git diff -U0 -- "$f" | grep -E '^[+-]' | grep -vE '^(\+\+\+|---)' | grep -vE "\?v=[0-9]|const APP_VERSION" || true)"
  if [[ -z "$other_changes" ]]; then
    echo "pre-commit: Version ${version} in ${f#./} nachgezogen" >&2
    git add "$f"
  fi
done
